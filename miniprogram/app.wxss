page {
  min-height: 100%;
  background: #eaf8ff;
  color: #173149;
  font-family: "STKaiti", "KaiTi", "FangSong", serif;
  box-sizing: border-box;
}

view,
text,
button,
input {
  box-sizing: border-box;
}

button { font: inherit; }
button::after { border: 0; }

.simple-page {
  position: relative;
  min-height: 100vh;
  padding: calc(env(safe-area-inset-top) + 104rpx) 38rpx calc(env(safe-area-inset-bottom) + 56rpx);
  overflow: hidden;
  background:
    radial-gradient(circle at 92% 5%, rgba(255,255,255,.88) 0, rgba(255,255,255,0) 250rpx),
    radial-gradient(circle at 8% 80%, rgba(255,255,255,.56) 0, rgba(255,255,255,0) 310rpx),
    #eaf8ff;
  color: #173149;
}

.simple-page::before {
  position: absolute;
  content: "";
  top: 184rpx;
  right: 62rpx;
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: #ffdc92;
}

.simple-page::after {
  position: absolute;
  content: "";
  right: 118rpx;
  top: 104rpx;
  width: 74rpx;
  height: 32rpx;
  border: 4rpx solid #8291a1;
  border-radius: 28rpx;
  background: #fffdf8;
}

.simple-nav {
  position: relative;
  z-index: 4;
  display: flex;
  align-items: center;
  height: 70rpx;
}

.back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  margin: 0;
  padding: 0;
  border: 3rpx solid rgba(23,49,73,.14);
  border-radius: 50%;
  background: rgba(255,253,248,.96);
  box-shadow: 0 8rpx 22rpx rgba(80,122,147,.11);
}

.back-arrow {
  width: 22rpx;
  height: 22rpx;
  border-left: 6rpx solid #173149;
  border-bottom: 6rpx solid #173149;
  transform: rotate(45deg) translate(3rpx,-3rpx);
}

.simple-title {
  position: relative;
  z-index: 2;
  display: block;
  max-width: 590rpx;
  margin-top: 58rpx;
  font-size: 56rpx;
  line-height: 1.18;
  font-weight: 900;
  letter-spacing: 3rpx;
}

.simple-title::after {
  position: absolute;
  content: "";
  left: 12rpx;
  bottom: -16rpx;
  width: 132rpx;
  height: 9rpx;
  border-radius: 50%;
  background: #ffc44f;
  transform: rotate(-4deg);
}

.simple-lead {
  position: relative;
  z-index: 2;
  display: block;
  max-width: 590rpx;
  margin-top: 34rpx;
  color: #71839a;
  font-size: 27rpx;
  line-height: 1.65;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.paper-panel {
  position: relative;
  z-index: 2;
  margin-top: 50rpx;
  padding: 42rpx 36rpx;
  border: 2rpx solid rgba(179,170,157,.46);
  border-radius: 40rpx;
  background: rgba(255,253,248,.97);
  box-shadow: 0 16rpx 38rpx rgba(80,122,147,.10);
}

.paper-panel::before {
  position: absolute;
  content: "";
  left: 12rpx;
  top: 8rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ffc44f;
  box-shadow: 0 -12rpx 0 -2rpx #ffc44f, 0 12rpx 0 -2rpx #ffc44f, -12rpx 0 0 -2rpx #ffc44f, 12rpx 0 0 -2rpx #ffc44f;
}

.field-label {
  display: block;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.text-field {
  width: 100%;
  height: 96rpx;
  padding: 0 28rpx;
  border: 3rpx solid #cfeaff;
  border-radius: 26rpx;
  background: #fafdff;
  color: #173149;
  font-family: sans-serif;
  font-size: 30rpx;
}

.primary-button,
.secondary-button {
  width: 100%;
  min-height: 94rpx;
  margin-top: 34rpx;
  border-radius: 48rpx;
  color: #173149;
  font-size: 31rpx;
  font-weight: 900;
  letter-spacing: 3rpx;
  box-shadow: 0 10rpx 22rpx rgba(80,122,147,.08);
}
.primary-button { background: #ffdc91; }
.secondary-button { background: #cfeaff; }

.mini-list { margin-top: 42rpx; }
.mini-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 108rpx;
  padding: 24rpx 4rpx;
  border-bottom: 2rpx dashed #cddce5;
  font-size: 30rpx;
  font-weight: 800;
}
.mini-row:last-child { border-bottom: 0; }
.mini-muted {
  display: block;
  margin-top: 9rpx;
  color: #71839a;
  font-family: sans-serif;
  font-size: 23rpx;
  font-weight: 600;
}

@media (max-width: 340px) {
  .simple-page { padding-right: 30rpx; padding-left: 30rpx; }
  .simple-title { font-size: 50rpx; }
  .paper-panel { padding-right: 30rpx; padding-left: 30rpx; }
}
