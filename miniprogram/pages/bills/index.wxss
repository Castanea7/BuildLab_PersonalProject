.mini-row { justify-content: flex-start; }
.bill-icon { flex: 0 0 58rpx; display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; margin-right: 20rpx; border-radius: 18rpx; background: #ffdc91; }
.bill-icon view { width: 22rpx; height: 22rpx; border: 4rpx solid #173149; border-radius: 50%; }
.bill-ticket { background: #cfeaff; transform: rotate(-3deg); }
.bill-ticket view { border-radius: 3rpx; transform: rotate(45deg); }
.bill-copy { flex: 1; min-width: 0; }
.bill-copy text { display: block; }
.mini-row > text { margin-left: 18rpx; font-family: sans-serif; font-size: 30rpx; font-weight: 800; }
.bill-item { align-items: flex-start; }
.bill-actions { display: flex; flex-direction: column; align-items: flex-end; gap: 6rpx; }
.bill-actions button { margin: 0; padding: 0; color: #4e8b74; background: transparent; font-size: 21rpx; line-height: 1.2; }
.bill-form-mask { position: fixed; z-index: 20; inset: 0; display: flex; align-items: flex-end; background: rgba(23,49,73,.35); }
.bill-form { width: 100%; max-height: 88vh; box-sizing: border-box; overflow-y: auto; padding: 34rpx 36rpx 44rpx; border-radius: 34rpx 34rpx 0 0; background: #fffdf8; }
.form-title { display: block; margin-bottom: 18rpx; color: #173149; font-size: 36rpx; font-weight: 900; }
.bill-form .field-label { margin-top: 18rpx; }
.usage-head { display: flex; align-items: flex-end; justify-content: space-between; }
.usage-head .field-label { margin-bottom: 0; }
.usage-mode { margin-top: 18rpx; color: #173149; font-size: 23rpx; }
.usage-mode radio { transform: scale(.72); }
.usage-note { margin-top: 18rpx; color: #71839a; font-size: 22rpx; }
.usage-picker-row, .usage-range-row { display: flex; align-items: center; gap: 12rpx; margin-top: 12rpx; }
.usage-range-row picker { flex: 1; }
.usage-range-row .date-field { text-align: center; }
.usage-preview { display: block; margin-top: 10rpx; color: #4e8b74; font-family: sans-serif; font-size: 22rpx; }
.radio-line { display: flex; align-items: center; justify-content: space-between; margin-top: 24rpx; color: #173149; font-size: 25rpx; font-weight: 700; }
.radio-line radio { transform: scale(.75); }
.member-checks { display: flex; flex-wrap: wrap; gap: 10rpx 18rpx; margin-top: 12rpx; color: #173149; font-size: 24rpx; }
.member-checks checkbox { transform: scale(.75); }
.member-picker-wrap { position: relative; margin-top: 12rpx; }
.member-picker-button { display: flex; align-items: center; justify-content: space-between; width: 100%; height: 72rpx; box-sizing: border-box; margin: 0; padding: 0 22rpx; border: 2rpx solid #d9e6eb; border-radius: 16rpx; background: #f8fcfc; color: #173149; font-size: 24rpx; text-align: left; }
.member-picker-button text { color: #4e8b74; font-size: 30rpx; }
.member-dropdown { position: absolute; z-index: 3; left: 0; right: 0; top: 82rpx; padding: 14rpx 20rpx; border: 2rpx solid #d9e6eb; border-radius: 16rpx; background: #fffdf8; box-shadow: 0 10rpx 24rpx rgba(23,49,73,.12); }
.member-dropdown label { display: block; padding: 10rpx 0; color: #173149; font-size: 24rpx; }
.member-dropdown checkbox { transform: scale(.75); }
.member-dropdown button { height: 48rpx; margin: 10rpx 0 0; border-radius: 24rpx; background: #e6f2eb; color: #4e8b74; font-size: 22rpx; line-height: 48rpx; }
.member-list { margin-top: 12rpx; }
.member-option { display: flex; align-items: center; justify-content: space-between; min-height: 62rpx; padding: 6rpx 0; color: #173149; font-size: 24rpx; }
.member-check { display: flex; align-items: center; }
.member-check checkbox { transform: scale(.75); }
.member-option .share-input-wrap { flex: 0 0 150rpx; }
.custom-shares > view { display: flex; align-items: center; justify-content: space-between; margin-top: 12rpx; color: #173149; font-size: 23rpx; }
.share-input-wrap { display: flex; align-items: center; width: 150rpx; height: 54rpx; box-sizing: border-box; padding: 0 14rpx; border: 2rpx solid #d9e6eb; border-radius: 12rpx; background: #f8fcfc; }
.share-input { flex: 1; min-width: 0; height: 50rpx; padding: 0; border: 0; background: transparent; }
.share-input-wrap > text { margin-left: 6rpx; color: #71839a; font-size: 21rpx; }
.form-buttons { display: flex; gap: 18rpx; margin-top: 26rpx; }
.form-buttons button { flex: 1; }
.form-error { display: flex; align-items: flex-start; gap: 10rpx; margin-top: 18rpx; color: #c65748; font-family: sans-serif; font-size: 24rpx; font-weight: 700; line-height: 1.5; }
.warning-icon { position: relative; flex: 0 0 28rpx; width: 0; height: 0; margin-top: 3rpx; border-right: 14rpx solid transparent; border-bottom: 25rpx solid #c65748; border-left: 14rpx solid transparent; }
.warning-mark { position: absolute; left: -2rpx; top: 7rpx; width: 4rpx; height: 8rpx; border-radius: 2rpx; background: #fffdf8; }
.warning-mark::after { position: absolute; content: ""; left: 0; bottom: -6rpx; width: 4rpx; height: 4rpx; border-radius: 50%; background: #fffdf8; }
.checkin-mask { position: fixed; z-index: 30; inset: 0; display: flex; align-items: center; justify-content: center; padding: 36rpx; background: rgba(23,49,73,.35); }
.checkin-modal { width: 100%; box-sizing: border-box; padding: 34rpx 30rpx 30rpx; border-radius: 30rpx; background: #fffdf8; }
.checkin-copy { display: block; margin-bottom: 20rpx; color: #71839a; font-size: 24rpx; line-height: 1.6; }
