<view class="home-page">
  <view class="hero">
    <button class="menu-button" aria-label="打开菜单" bindtap="openMenu">
      <view></view><view></view><view></view>
    </button>
    <view class="hero-copy">
      <view class="brand-lockup">
        <text class="brand-title">同行小本</text>
        <view class="brand-rays" aria-hidden="true"><view></view><view></view><view></view></view>
      </view>
      <text class="hero-slogan">和朋友一起，\n把每一笔快乐都记下来！</text>
      <view class="slogan-stroke" aria-hidden="true"></view>
    </view>
    <view class="sky-cloud" aria-hidden="true"></view>
    <view class="sun-dot" aria-hidden="true"></view>
    <image class="hero-illustration" src="/assets/hero-travelers-v2.png" mode="widthFix" aria-label="小狗和小猫一起查看旅行地图" />
    <view class="hero-ground" aria-hidden="true">
      <view class="ground-line"></view>
      <view class="ground-flower flower-one"></view>
      <view class="ground-flower flower-two"></view>
      <view class="ground-flower flower-three"></view>
    </view>
  </view>

  <view class="scenario-picker-mask" wx:if="{{showScenarioPicker}}" catchtap="closeMockSettings">
    <view class="scenario-picker" catchtap="noop">
      <view class="scenario-picker-head"><text>选择 Mock 场景</text><button bindtap="closeMockSettings">关闭</button></view>
      <view class="scenario-list"><button wx:for="{{scenarios}}" wx:key="id" class="scenario-option {{item.id === state.scenarioId ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectMockScenario">{{item.label}}</button></view>
    </view>
  </view>

  <view class="content">
    <view class="section-bar" wx:if="{{currentTrip}}">
      <text class="section-title">进行中</text>
      <button class="see-all" data-mode="active" bindtap="openTripList">查看全部<text>›</text></button>
    </view>

    <view class="trip-card" wx:if="{{activeTrip}}" data-trip-id="{{activeTrip.id}}" bindtap="goTrip">
      <view class="corner-flower flower-yellow" aria-hidden="true"></view>
      <view class="trip-summary">
        <view class="trip-main">
          <text class="trip-name">{{activeTrip.name}}</text>
          <text class="trip-meta">{{activeTrip.dateText}} · {{activeTrip.memberText}}</text>
        </view>
        <view class="payment" data-trip-id="{{activeTrip.id}}" catchtap="goSettlement">
          <text class="payment-label">{{activeTrip.balanceLabel}}</text>
          <view class="payment-value"><text>{{activeTrip.balanceText}}</text><text class="payment-arrow">›</text></view>
        </view>
      </view>
      <view class="card-actions">
        <button class="action-button record-button" data-trip-id="{{activeTrip.id}}" catchtap="recordTrip">
          <view class="pen-icon" aria-hidden="true"><view class="pen-cap"></view><view class="pen-body"></view><view class="pen-tip"></view></view>
          <text>记一笔</text>
        </button>
        <button class="action-button bills-button" data-trip-id="{{activeTrip.id}}" catchtap="goTrip">
          <view class="receipt-icon" aria-hidden="true"><view></view><view></view><view></view></view>
          <text>查看行程</text>
        </button>
      </view>
    </view>

    <view class="empty-panel" wx:if="{{!currentTrip}}">
      <view class="empty-plane" aria-hidden="true"><view></view><view></view></view>
      <text class="empty-title">还没有进行中的行程哦～</text>
      <text class="empty-copy">创建或加入一个行程，
和朋友一起开启一段美好的回忆吧！</text>
    </view>

    <view class="quick-grid">
      <button class="quick-card quick-create" bindtap="navigate" data-url="/pages/create/index">
        <view class="quick-copy"><text>创建行程</text><text class="quick-arrow">→</text></view>
        <view class="clipboard-icon" aria-hidden="true">
          <view class="clipboard-clip"></view>
          <view class="clipboard-paper"><view></view><view></view><view></view></view>
          <view class="icon-rays rays-yellow"><view></view><view></view></view>
        </view>
        <view class="scribble scribble-yellow" aria-hidden="true"></view>
      </button>
      <button class="quick-card quick-join" bindtap="navigate" data-url="/pages/join/index">
        <view class="quick-copy"><text>加入行程</text><text class="quick-arrow">→</text></view>
        <view class="ticket-icon" aria-hidden="true">
          <view class="ticket-heart"></view><view class="ticket-fold"></view>
          <view class="icon-rays rays-blue"><view></view><view></view></view>
        </view>
        <view class="scribble scribble-blue" aria-hidden="true"></view>
      </button>
    </view>

    <view class="section-bar ended-bar">
      <text class="section-title">已结束</text>
      <button class="see-all" wx:if="{{endedTrip}}" data-mode="ended" bindtap="openTripList">查看全部<text>›</text></button>
    </view>
    <view class="ended-card" wx:if="{{endedTrip}}" data-trip-id="{{endedTrip.id}}" bindtap="openReport">
      <view class="ended-copy">
        <text class="ended-name">{{endedTrip.name}}</text>
        <text class="ended-meta">{{endedTrip.dateText}} · {{endedTrip.memberText}}</text>
      </view>
      <button class="report-button" data-trip-id="{{endedTrip.id}}" catchtap="openReport">查看我的报告<text>›</text></button>
      <view class="corner-flower flower-blue" aria-hidden="true"></view>
      <view class="ended-landscape" aria-hidden="true"><view class="hill"></view><view class="sun-rays"><view></view><view></view><view></view></view><view class="sprout sprout-one"></view><view class="sprout sprout-two"></view></view>
    </view>
    <view class="empty-panel ended-empty" wx:if="{{!endedTrip}}">
      <view class="empty-box" aria-hidden="true"><view></view></view>
      <text class="empty-title">还没有结束的行程哦～</text>
      <text class="empty-copy">完成一段旅程后，这里会显示你的行程记录</text>
    </view>

    <view class="page-wish">
      <text>祝你拥有神奇的一天！</text>
      <view class="wish-underline" aria-hidden="true"></view>
      <view class="wish-sun" aria-hidden="true"><view></view><view></view><view></view><view></view><view></view><view></view></view>
    </view>
  </view>

</view>
