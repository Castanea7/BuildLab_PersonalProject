.trip-list-panel { padding: 24rpx; }
.trip-list-row { display: flex; align-items: center; min-height: 104rpx; padding: 18rpx 0; border-bottom: 2rpx solid #f0eee8; }
.trip-list-row:last-child { border-bottom: 0; }
.trip-list-copy { flex: 1; min-width: 0; }
.trip-list-name { display: block; color: #173149; font-size: 29rpx; font-weight: 900; }
.list-record-button { display: flex; align-items: center; justify-content: center; height: 52rpx; margin: 0; padding: 0 18rpx; border-radius: 26rpx; background: #ffdc91; color: #173149; font-size: 22rpx; line-height: 1; }
.list-report-arrow { color: #4e8b74; font-size: 23rpx; font-weight: 700; }
.list-empty { margin: 10rpx 0 0; padding: 34rpx 12rpx; background: transparent; }
