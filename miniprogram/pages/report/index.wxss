.report-page {
  position: relative;
  min-height: 100vh;
  padding: calc(env(safe-area-inset-top) + 54rpx) 30rpx calc(env(safe-area-inset-bottom) + 56rpx);
  overflow: hidden;
  background: #eaf8ff;
  color: #173b70;
}

.report-page::before,
.report-page::after {
  position: absolute;
  content: "";
  z-index: 0;
  border-radius: 50%;
  pointer-events: none;
}

.report-page::before { top: 160rpx; left: -120rpx; width: 330rpx; height: 330rpx; background: rgba(255,255,255,.40); }
.report-page::after { right: -110rpx; bottom: 170rpx; width: 310rpx; height: 310rpx; background: rgba(255,255,255,.54); }

.report-topbar,
.report-heading,
.report-card,
.report-footer { position: relative; z-index: 1; }

.report-topbar { display: flex; align-items: center; justify-content: space-between; height: 70rpx; }

.back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  margin: 0;
  padding: 0;
  border: 2rpx solid rgba(23,59,112,.12);
  border-radius: 50%;
  background: rgba(255,255,255,.78);
  box-shadow: 0 8rpx 20rpx rgba(73,134,171,.10);
}

.back-arrow { width: 22rpx; height: 22rpx; border-bottom: 5rpx solid #173b70; border-left: 5rpx solid #173b70; transform: rotate(45deg) translate(3rpx,-3rpx); }
.topbar-dots { display: flex; align-items: center; justify-content: space-evenly; width: 108rpx; height: 62rpx; border: 2rpx solid rgba(23,59,112,.12); border-radius: 32rpx; background: rgba(255,255,255,.82); }
.topbar-dots view { width: 10rpx; height: 10rpx; border-radius: 50%; background: #173b70; }

.report-heading { padding: 58rpx 16rpx 30rpx; }
.report-page-title { display: block; font-size: 42rpx; font-weight: 900; letter-spacing: 3rpx; }
.report-trip-name { display: block; margin-top: 18rpx; color: #173b70; font-size: 64rpx; line-height: 1.1; font-weight: 900; letter-spacing: 4rpx; }
.report-lead { display: block; max-width: 560rpx; margin-top: 20rpx; color: #6782a4; font-size: 24rpx; line-height: 1.7; font-weight: 600; }
.heading-sun { position: absolute; top: 62rpx; right: 56rpx; width: 56rpx; height: 56rpx; border-radius: 50%; background: #ffdb7e; box-shadow: 0 0 0 16rpx rgba(255,219,126,.13); }

.report-card { margin-top: 22rpx; padding: 34rpx 30rpx 30rpx; border: 1rpx solid rgba(211,230,237,.82); border-radius: 34rpx; background: rgba(255,255,255,.92); box-shadow: 0 16rpx 34rpx rgba(80,137,166,.10); }
.card-heading { display: flex; align-items: center; min-height: 46rpx; }
.card-title { margin-left: 16rpx; font-size: 31rpx; font-weight: 900; letter-spacing: 2rpx; }
.card-unit, .card-count { margin-left: auto; color: #6d86a6; font-size: 22rpx; font-weight: 700; }

.flower-icon { position: relative; width: 34rpx; height: 34rpx; flex: 0 0 34rpx; }
.flower-icon::before, .flower-icon::after, .flower-icon view { position: absolute; content: ""; width: 17rpx; height: 17rpx; border-radius: 50%; background: #ffd264; }
.flower-icon::before { left: 8rpx; top: 0; }.flower-icon::after { left: 8rpx; bottom: 0; }.flower-icon view { left: 0; top: 8rpx; box-shadow: 17rpx 0 0 #ffd264; }
.flower-icon view::after { position: absolute; content: ""; left: 13rpx; top: 5rpx; width: 8rpx; height: 8rpx; border-radius: 50%; background: #173b70; }
.question-icon { display: flex; align-items: center; justify-content: center; width: 26rpx; height: 26rpx; margin-left: 14rpx; border: 2rpx solid #8ba8c6; border-radius: 50%; color: #5d7fa4; font-family: sans-serif; font-size: 18rpx; font-weight: 800; }

.total-card { padding-bottom: 26rpx; }
.total-amount { display: block; margin-top: 22rpx; color: #173b70; font-family: sans-serif; font-size: 56rpx; font-weight: 900; letter-spacing: -1rpx; }
.stat-row { display: flex; align-items: stretch; margin-top: 24rpx; padding-top: 22rpx; border-top: 1rpx solid #e4edf2; }
.stat-item { display: flex; flex: 1; flex-direction: column; align-items: center; }
.stat-value { font-family: sans-serif; font-size: 30rpx; font-weight: 900; }.stat-label { margin-top: 8rpx; color: #6d86a6; font-size: 22rpx; font-weight: 700; }.stat-divider { width: 1rpx; background: #d8e5eb; }

.trend-chart { position: relative; height: 280rpx; margin-top: 28rpx; }
.trend-grid { position: absolute; right: 0; bottom: 52rpx; left: 0; height: 180rpx; display: flex; flex-direction: column; justify-content: space-between; }
.trend-grid view { border-top: 1rpx dashed #c8dbe7; }
.trend-bars { position: absolute; right: 10rpx; bottom: 0; left: 10rpx; display: flex; align-items: flex-end; justify-content: space-around; height: 240rpx; }
.trend-item { position: relative; display: flex; width: 20%; height: 100%; flex-direction: column; align-items: center; justify-content: flex-end; }
.trend-value { margin-bottom: 10rpx; color: #173b70; font-family: sans-serif; font-size: 20rpx; font-weight: 800; }.trend-bar { width: 52rpx; min-height: 18rpx; border-radius: 15rpx 15rpx 5rpx 5rpx; background: linear-gradient(180deg, #a5d5f7, #70afe7); }.trend-date { margin-top: 16rpx; color: #6d86a6; font-family: sans-serif; font-size: 21rpx; font-weight: 700; }

.category-card { min-height: 520rpx; }.category-content { display: flex; align-items: center; margin-top: 30rpx; flex-direction: column; }.category-chart-wrap { position: relative; width: 220rpx; height: 220rpx; flex: 0 0 220rpx; margin: 8rpx auto 22rpx; }.category-pie { display: block; width: 220rpx; height: 220rpx; }.category-center { position: absolute; top: 64rpx; left: 64rpx; display: flex; width: 92rpx; height: 92rpx; flex-direction: column; align-items: center; justify-content: center; border-radius: 50%; background: #fffdf8; }.category-center text:first-child { color: #173b70; font-family: sans-serif; font-size: 22rpx; font-weight: 900; }.category-center text:last-child { margin-top: 6rpx; color: #6d86a6; font-size: 17rpx; font-weight: 700; }.category-list { width: 100%; margin-left: 0; }.category-row { display: flex; align-items: center; justify-content: space-between; min-height: 58rpx; padding: 8rpx 0; border-top: 1rpx solid #e9f0f3; box-sizing: border-box; }.category-label { display: flex; align-items: center; min-width: 0; color: #507198; font-size: 22rpx; font-weight: 700; }.category-dot { width: 15rpx; height: 15rpx; flex: 0 0 15rpx; margin-right: 9rpx; border-radius: 50%; }.category-values { display: flex; flex-direction: column; align-items: flex-end; margin-left: 10rpx; }.category-ratio { color: #5d789b; font-family: sans-serif; font-size: 21rpx; font-weight: 800; }.category-amount { margin-top: 3rpx; color: #173b70; font-family: sans-serif; font-size: 20rpx; font-weight: 800; }
.cat-spark { width: 38rpx; height: 38rpx; margin-left: auto; border: 4rpx solid #8ab4df; border-radius: 50%; box-shadow: 12rpx 7rpx 0 -4rpx #ffcf61; }

.footprint-list { margin-top: 28rpx; }.footprint-day { position: relative; }.footprint-day + .footprint-day { margin-top: 28rpx; }.footprint-day-label { position: relative; z-index: 2; display: inline-flex; flex-direction: column; align-items: flex-start; transform: rotate(-2deg); }.day-badge { position: relative; padding: 7rpx 24rpx 6rpx 18rpx; border-radius: 10rpx 18rpx 8rpx 8rpx; background: #ffdc91; color: #173b70; font-family: sans-serif; font-size: 27rpx; font-weight: 900; letter-spacing: 1rpx; }.day-badge::after { position: absolute; content: ""; right: -12rpx; top: 0; border-top: 21rpx solid transparent; border-bottom: 21rpx solid transparent; border-left: 13rpx solid #ffdc91; }.day-date { margin: -1rpx 0 0 5rpx; padding: 6rpx 18rpx; border-radius: 5rpx 8rpx 8rpx 5rpx; background: #cfeaff; color: #173b70; font-family: sans-serif; font-size: 22rpx; font-weight: 800; }.footprint-route { position: relative; margin-top: -4rpx; padding: 14rpx 0 4rpx; }.route-dash { position: absolute; top: 26rpx; bottom: 28rpx; left: 49%; border-left: 3rpx dashed #376fb5; transform: rotate(7deg); opacity: .9; }.footprint-place { position: relative; z-index: 1; display: flex; align-items: center; min-height: 142rpx; }.place-left { padding-right: 8rpx; }.place-right { padding-left: 8rpx; }.place-pin { position: relative; z-index: 2; width: 42rpx; height: 50rpx; flex: 0 0 42rpx; border: 4rpx solid #173b70; border-radius: 50% 50% 50% 0; background: #ffad9e; transform: rotate(-45deg); box-shadow: 0 8rpx 0 rgba(255,173,158,.24); }.place-pin view { width: 13rpx; height: 13rpx; margin: 11rpx auto; border: 3rpx solid #173b70; border-radius: 50%; background: #fffdf8; }.place-copy { display: flex; min-width: 0; flex-direction: column; margin-left: 18rpx; }.place-left .place-copy { order: 2; }.place-right .place-copy { order: 2; }.footprint-name { color: #173b70; font-size: 27rpx; font-weight: 900; letter-spacing: 1rpx; }.footprint-date { margin-top: 6rpx; color: #7791af; font-family: sans-serif; font-size: 20rpx; font-weight: 700; }.footprint-art { position: relative; width: 144rpx; height: 92rpx; margin-left: auto; flex: 0 0 144rpx; }.footprint-art view { position: absolute; box-sizing: border-box; }.art-food::before { position: absolute; content: ""; left: 18rpx; top: 28rpx; width: 58rpx; height: 26rpx; border: 4rpx solid #173b70; border-radius: 50%; background: #ffd98c; transform: rotate(-8deg); }.art-food::after { position: absolute; content: ""; left: 25rpx; top: 37rpx; width: 44rpx; height: 12rpx; border-bottom: 4rpx solid #ff9f91; border-radius: 50%; }.art-food view:first-child { left: 92rpx; top: 17rpx; width: 4rpx; height: 55rpx; background: #173b70; transform: rotate(12deg); }.art-food view:nth-child(2) { left: 98rpx; top: 18rpx; width: 16rpx; height: 4rpx; background: #173b70; box-shadow: 0 12rpx 0 #173b70, 0 24rpx 0 #173b70; transform: rotate(12deg); }.art-food view:nth-child(3) { left: 7rpx; top: 58rpx; width: 30rpx; height: 16rpx; border-bottom: 4rpx solid #9bd3a3; border-radius: 50%; }.art-stay::before { position: absolute; content: ""; left: 26rpx; top: 24rpx; width: 82rpx; height: 48rpx; border: 4rpx solid #173b70; border-radius: 8rpx; background: #fffdf8; }.art-stay::after { position: absolute; content: ""; left: 18rpx; top: 13rpx; width: 98rpx; height: 40rpx; border: 4rpx solid #173b70; border-bottom: 0; border-radius: 50% 50% 0 0; background: #ffdc91; transform: skewX(-18deg); }.art-stay view:first-child { left: 43rpx; top: 48rpx; width: 14rpx; height: 17rpx; background: #7fc5f7; }.art-stay view:nth-child(2) { left: 76rpx; top: 48rpx; width: 14rpx; height: 17rpx; background: #7fc5f7; }.art-stay view:nth-child(3) { left: 11rpx; bottom: 9rpx; width: 40rpx; height: 14rpx; border-bottom: 4rpx solid #9bd3a3; border-radius: 50%; }.art-ticket::before { position: absolute; content: ""; left: 25rpx; top: 23rpx; width: 88rpx; height: 52rpx; border: 4rpx solid #173b70; border-radius: 10rpx; background: #ffb7aa; transform: rotate(-12deg); }.art-ticket::after { position: absolute; content: ""; left: 68rpx; top: 25rpx; height: 48rpx; border-left: 3rpx dashed #173b70; transform: rotate(-12deg); }.art-ticket view:first-child { left: 48rpx; top: 14rpx; width: 43rpx; height: 12rpx; border: 4rpx solid #173b70; border-bottom: 0; border-radius: 50% 50% 0 0; background: #fffdf8; transform: rotate(-12deg); }.art-ticket view:nth-child(2) { left: 43rpx; top: 48rpx; width: 16rpx; height: 4rpx; background: #fffdf8; transform: rotate(-12deg); }.art-ticket view:nth-child(3) { left: 9rpx; bottom: 10rpx; width: 32rpx; height: 16rpx; border-bottom: 4rpx solid #7fc5f7; border-radius: 50%; }.art-transport::before { position: absolute; content: ""; left: 28rpx; top: 30rpx; width: 88rpx; height: 31rpx; border: 4rpx solid #173b70; border-radius: 50% 48% 40% 60%; background: #fffdf8; transform: rotate(-8deg); }.art-transport::after { position: absolute; content: ""; left: 54rpx; top: 18rpx; width: 44rpx; height: 25rpx; border: 4rpx solid #173b70; border-bottom: 0; border-radius: 50% 50% 0 0; background: #7fc5f7; transform: rotate(-8deg); }.art-transport view:first-child { left: 46rpx; top: 62rpx; width: 15rpx; height: 15rpx; border: 4rpx solid #173b70; border-radius: 50%; background: #ffdc91; }.art-transport view:nth-child(2) { left: 98rpx; top: 62rpx; width: 15rpx; height: 15rpx; border: 4rpx solid #173b70; border-radius: 50%; background: #ffdc91; }.art-transport view:nth-child(3) { left: 7rpx; top: 15rpx; width: 32rpx; height: 18rpx; border-top: 4rpx solid #9bd3a3; border-radius: 50%; }.art-other::before { position: absolute; content: ""; left: 45rpx; top: 14rpx; width: 34rpx; height: 62rpx; border: 4rpx solid #173b70; border-radius: 50% 50% 45% 45%; background: #9bd3a3; transform: rotate(-8deg); }.art-other::after { position: absolute; content: ""; left: 61rpx; top: 0; width: 4rpx; height: 82rpx; background: #173b70; transform: rotate(8deg); }.art-other view:first-child { left: 28rpx; top: 36rpx; width: 36rpx; height: 20rpx; border-bottom: 4rpx solid #9bd3a3; border-radius: 50%; }.art-other view:nth-child(2) { left: 82rpx; top: 55rpx; width: 42rpx; height: 18rpx; border-bottom: 4rpx solid #7fc5f7; border-radius: 50%; }.art-other view:nth-child(3) { display: none; }

.footprint-card { overflow: hidden; }
.footprint-stage { position: relative; margin-top: 26rpx; padding: 0 4rpx 8rpx; }
.footprint-route-canvas { position: absolute; z-index: 0; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; }
.footprint-list { position: relative; z-index: 1; margin-top: 0; }
.footprint-day { position: relative; }
.footprint-day + .footprint-day { margin-top: 24rpx; padding-top: 4rpx; }
.footprint-day-label { position: relative; z-index: 3; display: inline-flex; margin-left: 2rpx; flex-direction: column; align-items: flex-start; transform: rotate(-2deg); }
.day-badge { position: relative; padding: 7rpx 24rpx 6rpx 18rpx; border-radius: 10rpx 18rpx 8rpx 8rpx; background: #ffdc91; color: #173b70; font-family: sans-serif; font-size: 27rpx; font-weight: 900; letter-spacing: 1rpx; }.day-badge::after { position: absolute; content: ""; right: -12rpx; top: 0; border-top: 21rpx solid transparent; border-bottom: 21rpx solid transparent; border-left: 13rpx solid #ffdc91; }.day-date { margin: -1rpx 0 0 5rpx; padding: 6rpx 18rpx; border-radius: 5rpx 8rpx 8rpx 5rpx; background: #cfeaff; color: #173b70; font-family: sans-serif; font-size: 22rpx; font-weight: 800; }
.footprint-route { position: relative; margin-top: 0; padding: 0; }
.footprint-place { position: relative; display: block; min-height: 154rpx; }
.place-pin { position: absolute; z-index: 4; top: 52rpx; box-sizing: border-box; width: 42rpx; height: 50rpx; margin-left: -21rpx; border: 4rpx solid #173b70; border-radius: 50% 50% 50% 0; background: #ffad9e; transform: rotate(-45deg); box-shadow: 0 8rpx 0 rgba(255,173,158,.24); }.place-pin view { width: 13rpx; height: 13rpx; margin: 11rpx auto; border: 3rpx solid #173b70; border-radius: 50%; background: #fffdf8; }
.place-content { position: absolute; top: 27rpx; display: flex; align-items: center; width: 108rpx; min-height: 84rpx; }.place-left .place-content { right: calc(50% + 56rpx); text-align: right; }.place-right .place-content { left: calc(50% + 56rpx); text-align: left; }
.place-copy { display: flex; width: 108rpx; min-width: 108rpx; flex: 0 0 108rpx; flex-direction: column; margin: 0; }.footprint-name { overflow: hidden; color: #173b70; font-size: 27rpx; font-weight: 900; letter-spacing: 1rpx; text-overflow: ellipsis; white-space: nowrap; }.footprint-date { margin-top: 6rpx; color: #7791af; font-family: sans-serif; font-size: 20rpx; font-weight: 700; }
.footprint-art { position: absolute; z-index: 4; top: 28rpx; width: 126rpx; height: 80rpx; margin: 0; }.place-left .footprint-art { left: calc(50% + 88rpx); transform: translateY(-4rpx) rotate(-2deg) scale(.86); transform-origin: left center; }.place-right .footprint-art { right: calc(50% + 88rpx); transform: translateY(6rpx) rotate(2deg) scale(.86); transform-origin: right center; }

.bill-list { margin-top: 18rpx; }.bill-row { display: flex; align-items: center; min-height: 82rpx; border-bottom: 1rpx solid #e9f0f3; }.bill-row:last-child { border-bottom: 0; }.bill-icon { position: relative; width: 42rpx; height: 42rpx; margin-right: 16rpx; border: 3rpx solid #7e9fc2; border-radius: 12rpx; background: #eaf5fc; }.bill-icon::before, .bill-icon::after, .bill-icon view { position: absolute; content: ""; left: 9rpx; width: 19rpx; height: 3rpx; border-radius: 3rpx; background: #7e9fc2; }.bill-icon::before { top: 11rpx; }.bill-icon::after { top: 20rpx; }.bill-icon view { top: 29rpx; width: 13rpx; }.bill-info { display: flex; flex: 1; flex-direction: column; }.bill-name { color: #173b70; font-size: 26rpx; font-weight: 900; }.bill-category { margin-top: 5rpx; color: #7791af; font-size: 20rpx; font-weight: 700; }.bill-amount { color: #173b70; font-family: sans-serif; font-size: 25rpx; font-weight: 900; }

.empty-copy { display: block; padding: 30rpx 0 8rpx; color: #849bb4; font-size: 23rpx; text-align: center; }.report-footer { display: flex; align-items: center; justify-content: center; margin: 42rpx 12rpx 0; color: #7e99b5; font-size: 20rpx; font-weight: 700; }.footer-line { width: 46rpx; height: 1rpx; margin: 0 14rpx; background: #a8c8dc; }
.report-danger-actions { margin: 30rpx 12rpx 0; }.delete-report-button { display: flex; align-items: center; justify-content: center; height: 78rpx; padding: 0; border: 2rpx solid #e58d8d; border-radius: 40rpx; background: rgba(255,255,255,.72); color: #c65f68; font-size: 26rpx; font-weight: 800; line-height: 1; }.delete-report-button::after { border: 0; }.delete-report-button[disabled] { opacity: .55; }

@media (max-width: 340px) { .report-page { padding-right: 22rpx; padding-left: 22rpx; }.report-card { padding-right: 24rpx; padding-left: 24rpx; }.report-trip-name { font-size: 56rpx; }.category-card { min-height: 480rpx; }.category-chart-wrap { width: 190rpx; height: 190rpx; flex-basis: 190rpx; }.category-pie { width: 190rpx; height: 190rpx; }.category-center { top: 54rpx; left: 54rpx; width: 82rpx; height: 82rpx; }.category-label { font-size: 20rpx; } }
