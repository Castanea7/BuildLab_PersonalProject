.report-summary { position: relative; overflow: hidden; }
.report-label { display: block; color: #71839a; font-size: 26rpx; font-weight: 700; }
.report-total { display: block; margin-top: 12rpx; font-family: sans-serif; font-size: 58rpx; font-weight: 800; }
.report-sun { position: absolute; right: 42rpx; top: 38rpx; width: 62rpx; height: 62rpx; border-radius: 50%; background: #ffdc92; }
.route-line { display: flex; align-items: center; justify-content: space-between; height: 80rpx; margin-top: 54rpx; border-top: 6rpx dashed #7fc5f7; }
.route-line view { width: 24rpx; height: 24rpx; margin-top: -15rpx; border: 6rpx solid #fffdf8; border-radius: 50%; background: #ff846d; }
.route-copy { display: block; margin-top: 10rpx; color: #5f7890; font-size: 26rpx; font-weight: 700; }
