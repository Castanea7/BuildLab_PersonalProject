.report-page {
  position: relative;
  min-height: 100vh;
  padding: calc(env(safe-area-inset-top) + 54rpx) 30rpx calc(env(safe-area-inset-bottom) + 56rpx);
  overflow: hidden;
  background: #eaf8ff;
  color: #173b70;
}

.report-page::before,
.report-page::after {
  position: absolute;
  content: "";
  z-index: 0;
  border-radius: 50%;
  pointer-events: none;
}

.report-page::before { top: 160rpx; left: -120rpx; width: 330rpx; height: 330rpx; background: rgba(255,255,255,.40); }
.report-page::after { right: -110rpx; bottom: 170rpx; width: 310rpx; height: 310rpx; background: rgba(255,255,255,.54); }

.report-topbar,
.report-heading,
.report-card,
.report-footer { position: relative; z-index: 1; }

.report-topbar { display: flex; align-items: center; justify-content: space-between; height: 70rpx; }

.back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  margin: 0;
  padding: 0;
  border: 2rpx solid rgba(23,59,112,.12);
  border-radius: 50%;
  background: rgba(255,255,255,.78);
  box-shadow: 0 8rpx 20rpx rgba(73,134,171,.10);
}

.back-arrow { width: 22rpx; height: 22rpx; border-bottom: 5rpx solid #173b70; border-left: 5rpx solid #173b70; transform: rotate(45deg) translate(3rpx,-3rpx); }
.topbar-dots { display: flex; align-items: center; justify-content: space-evenly; width: 108rpx; height: 62rpx; border: 2rpx solid rgba(23,59,112,.12); border-radius: 32rpx; background: rgba(255,255,255,.82); }
.topbar-dots view { width: 10rpx; height: 10rpx; border-radius: 50%; background: #173b70; }

.report-heading { padding: 58rpx 16rpx 30rpx; }
.report-page-title { display: block; font-size: 42rpx; font-weight: 900; letter-spacing: 3rpx; }
.report-trip-name { display: block; margin-top: 18rpx; color: #173b70; font-size: 64rpx; line-height: 1.1; font-weight: 900; letter-spacing: 4rpx; }
.report-lead { display: block; max-width: 560rpx; margin-top: 20rpx; color: #6782a4; font-size: 24rpx; line-height: 1.7; font-weight: 600; }
.heading-sun { position: absolute; top: 62rpx; right: 56rpx; width: 56rpx; height: 56rpx; border-radius: 50%; background: #ffdb7e; box-shadow: 0 0 0 16rpx rgba(255,219,126,.13); }

.report-card { margin-top: 22rpx; padding: 34rpx 30rpx 30rpx; border: 1rpx solid rgba(211,230,237,.82); border-radius: 34rpx; background: rgba(255,255,255,.92); box-shadow: 0 16rpx 34rpx rgba(80,137,166,.10); }
.card-heading { display: flex; align-items: center; min-height: 46rpx; }
.card-title { margin-left: 16rpx; font-size: 31rpx; font-weight: 900; letter-spacing: 2rpx; }
.card-unit, .card-count { margin-left: auto; color: #6d86a6; font-size: 22rpx; font-weight: 700; }

.flower-icon { position: relative; width: 34rpx; height: 34rpx; flex: 0 0 34rpx; }
.flower-icon::before, .flower-icon::after, .flower-icon view { position: absolute; content: ""; width: 17rpx; height: 17rpx; border-radius: 50%; background: #ffd264; }
.flower-icon::before { left: 8rpx; top: 0; }.flower-icon::after { left: 8rpx; bottom: 0; }.flower-icon view { left: 0; top: 8rpx; box-shadow: 17rpx 0 0 #ffd264; }
.flower-icon view::after { position: absolute; content: ""; left: 13rpx; top: 5rpx; width: 8rpx; height: 8rpx; border-radius: 50%; background: #173b70; }
.question-icon { display: flex; align-items: center; justify-content: center; width: 26rpx; height: 26rpx; margin-left: 14rpx; border: 2rpx solid #8ba8c6; border-radius: 50%; color: #5d7fa4; font-family: sans-serif; font-size: 18rpx; font-weight: 800; }

.total-card { padding-bottom: 26rpx; }
.total-amount { display: block; margin-top: 22rpx; color: #173b70; font-family: sans-serif; font-size: 56rpx; font-weight: 900; letter-spacing: -1rpx; }
.stat-row { display: flex; align-items: stretch; margin-top: 24rpx; padding-top: 22rpx; border-top: 1rpx solid #e4edf2; }
.stat-item { display: flex; flex: 1; flex-direction: column; align-items: center; }
.stat-value { font-family: sans-serif; font-size: 30rpx; font-weight: 900; }.stat-label { margin-top: 8rpx; color: #6d86a6; font-size: 22rpx; font-weight: 700; }.stat-divider { width: 1rpx; background: #d8e5eb; }

.trend-chart { position: relative; height: 280rpx; margin-top: 28rpx; }
.trend-grid { position: absolute; right: 0; bottom: 52rpx; left: 0; height: 180rpx; display: flex; flex-direction: column; justify-content: space-between; }
.trend-grid view { border-top: 1rpx dashed #c8dbe7; }
.trend-bars { position: absolute; right: 10rpx; bottom: 0; left: 10rpx; display: flex; align-items: flex-end; justify-content: space-around; height: 240rpx; }
.trend-item { position: relative; display: flex; width: 20%; height: 100%; flex-direction: column; align-items: center; justify-content: flex-end; }
.trend-value { margin-bottom: 10rpx; color: #173b70; font-family: sans-serif; font-size: 20rpx; font-weight: 800; }.trend-bar { width: 52rpx; min-height: 18rpx; border-radius: 15rpx 15rpx 5rpx 5rpx; background: linear-gradient(180deg, #a5d5f7, #70afe7); }.trend-date { margin-top: 16rpx; color: #6d86a6; font-family: sans-serif; font-size: 21rpx; font-weight: 700; }

.category-card { min-height: 520rpx; }.category-content { display: flex; align-items: center; margin-top: 30rpx; flex-direction: column; }.category-chart-wrap { position: relative; width: 220rpx; height: 220rpx; flex: 0 0 220rpx; margin: 8rpx auto 22rpx; }.category-pie { display: block; width: 220rpx; height: 220rpx; }.category-center { position: absolute; top: 64rpx; left: 64rpx; display: flex; width: 92rpx; height: 92rpx; flex-direction: column; align-items: center; justify-content: center; border-radius: 50%; background: #fffdf8; }.category-center text:first-child { color: #173b70; font-family: sans-serif; font-size: 22rpx; font-weight: 900; }.category-center text:last-child { margin-top: 6rpx; color: #6d86a6; font-size: 17rpx; font-weight: 700; }.category-list { width: 100%; margin-left: 0; }.category-row { display: flex; align-items: center; justify-content: space-between; min-height: 58rpx; padding: 8rpx 0; border-top: 1rpx solid #e9f0f3; box-sizing: border-box; }.category-label { display: flex; align-items: center; min-width: 0; color: #507198; font-size: 22rpx; font-weight: 700; }.category-dot { width: 15rpx; height: 15rpx; flex: 0 0 15rpx; margin-right: 9rpx; border-radius: 50%; }.category-values { display: flex; flex-direction: column; align-items: flex-end; margin-left: 10rpx; }.category-ratio { color: #5d789b; font-family: sans-serif; font-size: 21rpx; font-weight: 800; }.category-amount { margin-top: 3rpx; color: #173b70; font-family: sans-serif; font-size: 20rpx; font-weight: 800; }
.cat-spark { width: 38rpx; height: 38rpx; margin-left: auto; border: 4rpx solid #8ab4df; border-radius: 50%; box-shadow: 12rpx 7rpx 0 -4rpx #ffcf61; }

.footprint-list { margin-top: 26rpx; }.footprint-row { display: flex; min-height: 78rpx; }.footprint-rail { position: relative; width: 54rpx; flex: 0 0 54rpx; }.footprint-rail::after { position: absolute; content: ""; top: 39rpx; bottom: -1rpx; left: 19rpx; border-left: 3rpx dashed #92c7ed; }.footprint-row:last-child .footprint-rail::after { display: none; }
.map-pin { position: relative; z-index: 1; width: 40rpx; height: 48rpx; border: 4rpx solid #173b70; border-radius: 50% 50% 50% 0; background: #ffb29e; transform: rotate(-45deg); }.map-pin view { width: 12rpx; height: 12rpx; margin: 11rpx auto; border: 3rpx solid #173b70; border-radius: 50%; background: #fff; }.footprint-info { display: flex; flex: 1; align-items: center; justify-content: space-between; padding: 0 8rpx 0 16rpx; border-bottom: 1rpx solid #e9f0f3; }.footprint-row:last-child .footprint-info { border-bottom: 0; }.footprint-name { color: #173b70; font-size: 28rpx; font-weight: 900; }.footprint-date { color: #7791af; font-family: sans-serif; font-size: 22rpx; font-weight: 700; }

.bill-list { margin-top: 18rpx; }.bill-row { display: flex; align-items: center; min-height: 82rpx; border-bottom: 1rpx solid #e9f0f3; }.bill-row:last-child { border-bottom: 0; }.bill-icon { position: relative; width: 42rpx; height: 42rpx; margin-right: 16rpx; border: 3rpx solid #7e9fc2; border-radius: 12rpx; background: #eaf5fc; }.bill-icon::before, .bill-icon::after, .bill-icon view { position: absolute; content: ""; left: 9rpx; width: 19rpx; height: 3rpx; border-radius: 3rpx; background: #7e9fc2; }.bill-icon::before { top: 11rpx; }.bill-icon::after { top: 20rpx; }.bill-icon view { top: 29rpx; width: 13rpx; }.bill-info { display: flex; flex: 1; flex-direction: column; }.bill-name { color: #173b70; font-size: 26rpx; font-weight: 900; }.bill-category { margin-top: 5rpx; color: #7791af; font-size: 20rpx; font-weight: 700; }.bill-amount { color: #173b70; font-family: sans-serif; font-size: 25rpx; font-weight: 900; }

.empty-copy { display: block; padding: 30rpx 0 8rpx; color: #849bb4; font-size: 23rpx; text-align: center; }.report-footer { display: flex; align-items: center; justify-content: center; margin: 42rpx 12rpx 0; color: #7e99b5; font-size: 20rpx; font-weight: 700; }.footer-line { width: 46rpx; height: 1rpx; margin: 0 14rpx; background: #a8c8dc; }

@media (max-width: 340px) { .report-page { padding-right: 22rpx; padding-left: 22rpx; }.report-card { padding-right: 24rpx; padding-left: 24rpx; }.report-trip-name { font-size: 56rpx; }.category-card { min-height: 480rpx; }.category-chart-wrap { width: 190rpx; height: 190rpx; flex-basis: 190rpx; }.category-pie { width: 190rpx; height: 190rpx; }.category-center { top: 54rpx; left: 54rpx; width: 82rpx; height: 82rpx; }.category-label { font-size: 20rpx; } }
