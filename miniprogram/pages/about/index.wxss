.about-page {
  box-sizing: border-box;
  height: 100vh;
  color: #173b70;
  background: #eaf8ff;
}

.about-topbar { position: relative; z-index: 8; height: calc(env(safe-area-inset-top) + 98rpx); }
.about-back { position: absolute; left: 28rpx; top: calc(env(safe-area-inset-top) + 38rpx); display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; margin: 0; padding: 0; border: 0; border-radius: 50%; background: rgba(255,253,248,.74); }
.about-back-arrow { width: 22rpx; height: 22rpx; border-left: 5rpx solid #173b70; border-bottom: 5rpx solid #173b70; transform: rotate(45deg) translate(3rpx,-3rpx); }
.about-nav-title { position: absolute; top: calc(env(safe-area-inset-top) + 48rpx); left: 50%; color: #173b70; font-size: 30rpx; font-weight: 900; letter-spacing: 2rpx; transform: translateX(-50%); white-space: nowrap; }
.about-menu { position: absolute; top: calc(env(safe-area-inset-top) + 40rpx); right: 112rpx; display: flex; align-items: center; gap: 7rpx; width: 78rpx; height: 52rpx; padding-left: 18rpx; border: 2rpx solid #c1d2dd; border-radius: 30rpx; background: rgba(255,255,255,.72); }.about-menu view { width: 7rpx; height: 7rpx; border-radius: 50%; background: #173b70; }.about-menu-dot { position: absolute; top: calc(env(safe-area-inset-top) + 40rpx); right: 34rpx; width: 52rpx; height: 52rpx; border: 2rpx solid #c1d2dd; border-radius: 50%; background: rgba(255,255,255,.72); }.about-menu-dot::before { position: absolute; content: ""; left: 16rpx; top: 14rpx; width: 14rpx; height: 14rpx; border: 4rpx solid #173b70; border-radius: 50%; }

.about-hero { position: relative; min-height: 610rpx; padding: 54rpx 34rpx 0; overflow: hidden; background: linear-gradient(180deg, #dff5ff 0%, #eaf8ff 78%, #fafdff 100%); }
.about-hero-copy { position: relative; z-index: 3; width: 54%; }
.about-big-title { display: block; color: #173b70; font-size: 86rpx; line-height: .98; font-weight: 900; letter-spacing: 2rpx; transform: rotate(-3deg); white-space: pre-line; }
.about-slogan { display: block; margin: 34rpx 0 0 20rpx; color: #173b70; font-size: 28rpx; line-height: 1.7; font-weight: 900; letter-spacing: 1rpx; transform: rotate(-2deg); white-space: pre-line; }.about-yellow-line { width: 250rpx; height: 8rpx; margin: 10rpx 0 0 28rpx; border-radius: 50%; background: #ffcf4d; transform: rotate(-7deg); }
.about-rays { position: absolute; top: 34rpx; right: -24rpx; width: 66rpx; height: 62rpx; }.about-rays view { position: absolute; width: 8rpx; height: 42rpx; border-radius: 10rpx; background: #ffcf4d; }.about-rays view:first-child { left: 4rpx; top: 2rpx; transform: rotate(28deg); }.about-rays view:nth-child(2) { left: 28rpx; top: 18rpx; transform: rotate(52deg); }.about-rays view:nth-child(3) { right: 0; top: 42rpx; height: 8rpx; width: 36rpx; }
.about-hero-art { position: absolute; z-index: 4; right: -18rpx; bottom: 58rpx; width: 500rpx; }.about-sun { position: absolute; z-index: 1; right: 50rpx; top: 98rpx; width: 86rpx; height: 86rpx; border-radius: 50%; background: rgba(255,220,145,.9); }.about-cloud { position: absolute; z-index: 1; width: 82rpx; height: 30rpx; border: 4rpx solid #fff; border-radius: 30rpx; background: rgba(255,255,255,.88); }.about-cloud::before, .about-cloud::after { position: absolute; content: ""; bottom: 10rpx; border: 4rpx solid #fff; border-bottom: 0; border-radius: 30rpx 30rpx 0 0; background: rgba(255,255,255,.88); }.about-cloud::before { left: 10rpx; width: 30rpx; height: 26rpx; }.about-cloud::after { right: 8rpx; width: 25rpx; height: 20rpx; }.cloud-one { top: 156rpx; right: 260rpx; transform: scale(.82); }.cloud-two { top: 126rpx; right: 28rpx; transform: scale(.62); }
.about-mountain { position: absolute; bottom: 82rpx; left: -50rpx; width: 490rpx; height: 152rpx; background: #a8d9f4; clip-path: polygon(0 76%, 22% 46%, 39% 62%, 61% 18%, 77% 56%, 100% 32%, 100% 100%, 0 100%); opacity: .72; }.mountain-back::after { position: absolute; content: ""; right: 42rpx; top: 25rpx; width: 150rpx; height: 50rpx; background: #72bce9; clip-path: polygon(0 100%, 45% 0, 100% 100%); }.about-water { position: absolute; bottom: 56rpx; left: -30rpx; width: 760rpx; height: 76rpx; border-radius: 50% 50% 0 0; background: rgba(255,255,255,.78); transform: rotate(-3deg); }.about-grass { position: absolute; z-index: 5; bottom: 44rpx; left: 36rpx; width: 120rpx; height: 72rpx; }.about-grass view { position: absolute; bottom: 0; width: 10rpx; height: 62rpx; border-radius: 50%; background: #69b990; transform-origin: bottom; }.about-grass view:first-child { left: 12rpx; transform: rotate(-28deg); }.about-grass view:nth-child(2) { left: 46rpx; height: 72rpx; transform: rotate(4deg); }.about-grass view:nth-child(3) { left: 82rpx; transform: rotate(28deg); }

.about-story { position: relative; z-index: 5; padding: 56rpx 64rpx 44rpx; background: #fffdf8; }.about-paragraph, .about-contact-copy, .about-contact-note { display: block; color: #173b70; font-size: 27rpx; line-height: 1.85; letter-spacing: 1rpx; }.about-paragraph-spaced { margin-top: 38rpx; }.about-highlight { position: relative; margin-top: 28rpx; padding: 8rpx 0 18rpx; color: #173b70; font-size: 36rpx; line-height: 1.65; font-weight: 900; letter-spacing: 1rpx; transform: rotate(-2deg); }.about-highlight text { display: block; }.highlight-line { height: 8rpx; border-radius: 50%; background: #ffcf4d; transform: rotate(-2deg); }.line-one { width: 342rpx; margin: -4rpx 0 12rpx 4rpx; }.line-two { width: 390rpx; margin: -2rpx 0 0 22rpx; }.highlight-rays { top: 14rpx; right: 0; transform: scale(.72); }

.about-scene { position: relative; height: 360rpx; overflow: hidden; background: #eaf8ff; }.about-scene::before, .about-scene::after { position: absolute; z-index: 6; content: ""; left: -8%; width: 116%; height: 104rpx; border-radius: 50%; background: #fffdf8; pointer-events: none; }.about-scene::before { top: -58rpx; transform: rotate(-2deg); }.about-scene::after { bottom: -68rpx; transform: rotate(2deg); }.about-scenery-water { position: absolute; left: -40rpx; right: -40rpx; bottom: 0; height: 190rpx; background: #9edcf8; border-radius: 50% 50% 0 0; }.about-scenery-water::after { position: absolute; content: ""; left: 40rpx; right: 70rpx; top: 56rpx; height: 8rpx; border-top: 5rpx solid rgba(255,255,255,.72); border-bottom: 5rpx solid rgba(255,255,255,.5); transform: rotate(2deg); }.about-scenery-hill { position: absolute; z-index: 1; bottom: 105rpx; width: 330rpx; height: 130rpx; background: #71b7e7; clip-path: polygon(0 100%, 48% 12%, 100% 100%); }.hill-left { left: -100rpx; }.hill-right { right: -70rpx; transform: scale(.84); }.about-scene-art { position: absolute; z-index: 3; bottom: 48rpx; left: 50%; width: 330rpx; transform: translateX(-50%); }.scene-grass { position: absolute; z-index: 4; bottom: 0; width: 150rpx; height: 102rpx; border-radius: 50% 50% 0 0; background: #83c995; }.scene-grass-left { left: -22rpx; transform: rotate(-12deg); }.scene-grass-right { right: -22rpx; transform: rotate(12deg); }

.about-contact { position: relative; padding: 52rpx 64rpx 42rpx; overflow: hidden; background: #fffdf8; }.about-section-title { position: relative; display: inline-block; color: #173b70; font-size: 52rpx; line-height: 1.2; font-weight: 900; }.title-rays { position: absolute; top: 4rpx; right: -58rpx; width: 42rpx; height: 50rpx; }.title-rays view { position: absolute; width: 7rpx; height: 32rpx; border-radius: 8rpx; background: #ffcf4d; transform: rotate(28deg); }.title-rays view:first-child { left: 4rpx; top: 0; }.title-rays view:last-child { right: 0; top: 18rpx; transform: rotate(70deg); }.about-contact-copy { margin-top: 20rpx; }.about-email { display: flex; align-items: center; min-height: 82rpx; margin-top: 24rpx; padding: 0 22rpx; border-radius: 24rpx; background: #d9f2ff; color: #173b70; font-family: sans-serif; font-size: 22rpx; font-weight: 900; }.mail-icon { position: relative; width: 44rpx; height: 32rpx; border: 4rpx solid #173b70; border-radius: 5rpx; }.mail-icon::before, .mail-icon::after { position: absolute; content: ""; top: 2rpx; width: 25rpx; border-top: 4rpx solid #173b70; }.mail-icon::before { left: 0; transform: rotate(32deg); }.mail-icon::after { right: 0; transform: rotate(-32deg); }.mail-divider { height: 34rpx; margin: 0 20rpx; border-left: 3rpx solid #80c7ed; }.about-contact-note { margin-top: 26rpx; }

.about-footer { position: relative; padding: 34rpx 0 0; overflow: hidden; text-align: center; background: linear-gradient(180deg, #fffdf8 0%, #eaf8ff 100%); }.about-footer text { position: relative; z-index: 2; display: block; color: #173b70; font-size: 27rpx; font-weight: 900; }.footer-line { position: relative; z-index: 2; width: 300rpx; height: 7rpx; margin: 14rpx auto 0; border-radius: 50%; background: #ffcf4d; transform: rotate(-3deg); }.about-footer-art { display: block; width: 100%; margin-top: 24rpx; }

@media (max-width: 340px) {
  .about-big-title { font-size: 76rpx; }
  .about-story, .about-contact { padding-right: 42rpx; padding-left: 42rpx; }
  .about-hero-art { right: -70rpx; width: 460rpx; }
  .about-paragraph, .about-contact-copy, .about-contact-note { font-size: 25rpx; }
  .about-highlight { font-size: 32rpx; }
  .about-email { padding-right: 14rpx; padding-left: 14rpx; font-size: 19rpx; }
}
