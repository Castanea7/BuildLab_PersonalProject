.profile-card { display: flex; align-items: center; }
.avatar { position: relative; width: 104rpx; height: 94rpx; margin-right: 28rpx; }
.avatar-face { position: absolute; left: 5rpx; bottom: 0; width: 94rpx; height: 76rpx; border: 5rpx solid #173149; border-radius: 46% 46% 50% 50%; background: #fff3df; }
.avatar-ear { position: absolute; z-index: -1; top: 3rpx; width: 38rpx; height: 38rpx; border: 5rpx solid #173149; background: #ffc176; transform: rotate(45deg); }
.avatar-ear-left { left: 8rpx; }
.avatar-ear-right { right: 8rpx; }
.avatar-eye { position: absolute; top: 34rpx; width: 7rpx; height: 7rpx; border-radius: 50%; background: #173149; }
.avatar-eye-left { left: 24rpx; }
.avatar-eye-right { right: 24rpx; }
.avatar-nose { position: absolute; left: 42rpx; top: 46rpx; width: 9rpx; height: 7rpx; border-radius: 50%; background: #ff9c8d; }
.profile-name { display: block; margin-bottom: 12rpx; font-size: 32rpx; font-weight: 900; }
