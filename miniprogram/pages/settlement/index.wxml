<view class="simple-page settlement-page">
  <view class="simple-nav"><button class="back-button" aria-label="返回" bindtap="goBack"><view class="back-arrow"></view></button></view>
  <text class="simple-title">本轮结账</text>
  <text class="simple-lead">线下完成付款后，由相关成员确认“已结清”。</text>
  <view class="paper-panel settlement-panel">
    <view class="settlement-section">
      <text class="settlement-section-title">当前阶段 {{preview.stage || '-'}}</text>
      <view class="settlement-row transfer-row" wx:for="{{preview.transfers}}" wx:key="id"><text>{{item.fromName}} → {{item.toName}}</text><text class="settlement-amount">{{item.amountText}}</text></view>
      <text class="settlement-empty" wx:if="{{!preview.billIds.length}}">当前阶段暂无可结账公共账单</text>
    </view>
    <button class="primary-button" bindtap="createSettlement" wx:if="{{preview.billIds.length}}">已结清</button>
    <view class="settlement-history" wx:for="{{settlements}}" wx:key="id">
      <view class="history-head"><text>第 {{item.stage}} 阶段</text><text>{{item.status === 'complete' ? '已完成' : '进行中'}}</text></view>
      <view class="settlement-row" wx:for="{{item.transfers}}" wx:key="id"><text>{{item.fromName}} → {{item.toName}}</text><text class="settlement-amount">{{item.amountText}}</text></view>
      <button class="secondary-button" data-id="{{item.id}}" bindtap="confirmSettlement" wx:if="{{item.status !== 'complete' && item.memberIds.indexOf(currentUserId) >= 0 && !item.currentConfirmed}}">我已结清</button>
    </view>
    <text class="settlement-note">快照创建后，相关账单会锁定；新账单自动进入下一阶段。</text>
  </view>
</view>
