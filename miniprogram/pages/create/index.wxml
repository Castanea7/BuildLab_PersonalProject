<view class="simple-page">
  <view class="simple-nav"><button class="back-button" aria-label="返回" bindtap="goBack"><view class="back-arrow"></view></button></view>
  <text class="simple-title">创建一段新旅程</text>
  <text class="simple-lead">先给这次同行取个好记的名字，邀请信息将在下一步生成。</text>
  <view class="paper-panel form-panel">
    <view class="form-clipboard" aria-hidden="true"><view class="form-clip"></view><view class="form-paper"><view></view><view></view><view></view></view></view>
    <text class="field-label">行程名称</text>
    <input class="text-field" placeholder="例如：海风周末" maxlength="16" />
    <button class="primary-button" bindtap="submit">创建行程</button>
  </view>
</view>
