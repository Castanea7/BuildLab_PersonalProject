.form-panel { padding-top: 118rpx; }
.date-label { display: block; margin-top: 26rpx; }
.date-field { margin-top: 14rpx; padding: 22rpx 24rpx; border: 2rpx solid #d8e5ec; border-radius: 16rpx; color: #71839a; font-size: 28rpx; background: #f9fcfd; }
.form-error { display: block; margin-top: 18rpx; color: #c65748; font-size: 24rpx; font-weight: 700; }
.created-modal-mask { position: fixed; z-index: 50; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; padding: 44rpx; background: rgba(23, 49, 73, 0.34); }
.created-modal { width: 100%; padding: 46rpx 34rpx 30rpx; border: 2rpx solid #eadfca; border-radius: 34rpx; background: #fffdf8; box-shadow: 0 22rpx 60rpx rgba(23, 49, 73, 0.24); text-align: center; }
.created-title { display: block; color: #173149; font-size: 42rpx; font-weight: 900; letter-spacing: 4rpx; }
.created-copy { display: block; margin-top: 16rpx; color: #71839a; font-size: 25rpx; }
.created-trip-name { display: block; margin-top: 24rpx; color: #173149; font-size: 30rpx; font-weight: 900; }
.created-code-card { margin-top: 24rpx; padding: 24rpx; border-radius: 24rpx; background: #fff3cf; }
.created-code { display: block; color: #173149; font-family: sans-serif; font-size: 64rpx; font-weight: 900; letter-spacing: 14rpx; }
.copy-button { width: 100%; height: 70rpx; margin-top: 20rpx; border-radius: 36rpx; background: #ffdc91; color: #173149; font-size: 27rpx; font-weight: 900; }
.invite-created-button { width: 100%; height: 70rpx; margin-top: 18rpx; border-radius: 36rpx; background: #ffdc91; color: #173149; font-size: 27rpx; font-weight: 900; }
.close-created-button { width: 100%; height: 70rpx; margin-top: 14rpx; border: 2rpx solid #d8e5ec; border-radius: 36rpx; background: #f5fbff; color: #173149; font-size: 27rpx; font-weight: 900; }
.form-clipboard { position: absolute; right: 42rpx; top: -36rpx; width: 106rpx; height: 126rpx; transform: rotate(7deg); }
.form-paper { position: absolute; left: 10rpx; top: 24rpx; width: 82rpx; height: 96rpx; padding: 35rpx 14rpx 0; border: 5rpx solid #173149; border-radius: 10rpx; background: #fffdf8; }
.form-paper view { height: 4rpx; margin-bottom: 12rpx; border-radius: 4rpx; background: #9aabc0; }
.form-clip { position: absolute; z-index: 2; left: 30rpx; top: 10rpx; width: 46rpx; height: 30rpx; border: 5rpx solid #173149; border-radius: 7rpx; background: #ffc44f; }
