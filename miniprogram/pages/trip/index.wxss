.trip-state {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 26rpx;
  border-radius: 32rpx;
  background: #cfeaff;
  color: #173149;
  font-size: 27rpx;
  font-weight: 900;
}
.state-dot { width: 12rpx; height: 12rpx; margin-right: 12rpx; border-radius: 50%; background: #ffc44f; }
.balance-block {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 48rpx;
  padding-bottom: 30rpx;
  border-bottom: 2rpx dashed #cddce5;
  color: #71839a;
  font-size: 27rpx;
}
.balance { color: #173149; font-family: sans-serif; font-size: 48rpx; font-weight: 800; }
