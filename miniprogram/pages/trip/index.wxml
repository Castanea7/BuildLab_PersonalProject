<view wx:if="{{trip}}" class="simple-page">
  <view class="simple-nav"><button class="back-button" aria-label="返回" bindtap="goBack"><view class="back-arrow"></view></button></view>
  <text class="simple-title">{{trip.name}}</text>
  <text class="simple-lead">{{trip.dateText}} · {{trip.memberText}}</text>
  <view class="paper-panel">
      <view class="trip-state"><view class="state-dot"></view><text>{{trip.status}}</text></view>
    <view class="invite-block" wx:if="{{trip.status === '进行中'}}">
      <text class="invite-label">行程邀请码</text>
      <text class="invite-code">{{trip.inviteCode}}</text>
      <button class="invite-copy-link" bindtap="copyInvite"><view class="invite-copy-icon" aria-hidden="true"><view></view></view><text>复制邀请码</text></button>
    </view>
    <view class="members-block">
      <text class="members-title">同行成员 · {{trip.memberText}}</text>
      <view class="member-row" wx:for="{{trip.members}}" wx:key="id">
        <view class="member-info"><text>{{item.name || item.id}}</text><text class="member-status">{{item.status === 'removed' ? '已移除' : item.role === 'owner' ? '房主' : '成员'}}</text></view>
        <button wx:if="{{isOwner && item.id !== currentUserId && item.status !== 'removed'}}" class="remove-member" data-id="{{item.id}}" catchtap="removeMember">移除</button>
      </view>
    </view>
    <view class="bills-block">
      <view class="bills-title-row"><text class="members-title">账单列表</text><text class="bills-note">本轮仅展示</text></view>
      <view class="bill-row" wx:for="{{trip.bills}}" wx:key="id">
        <view class="bill-copy"><text class="bill-name">{{item.name}}</text><text class="member-status">总金额 {{item.amountText}}</text></view>
        <view class="bill-side"><view class="bill-share"><text class="member-status bill-share-label">我花了</text><text class="bill-amount">{{item.shareText}}</text></view><view class="bill-actions"><button wx:if="{{!item.locked && item.createdBy === currentUserId}}" data-id="{{item.id}}" catchtap="editBill">编辑</button><button wx:else data-id="{{item.id}}" catchtap="viewBill">查看</button><button wx:if="{{!item.locked && item.createdBy === currentUserId}}" data-id="{{item.id}}" catchtap="deleteBill">删除</button></view></view>
      </view>
      <text class="empty-bills" wx:if="{{!trip.bills || !trip.bills.length}}">暂时还没有账单</text>
    </view>
    <view class="balance-block">
      <text>当前行程总花销</text><text class="balance">{{trip.totalExpenseText}}</text>
    </view>
    <button class="primary-button" bindtap="record" wx:if="{{trip.status === '进行中'}}">{{showRecordHint ? '继续记一笔' : '记一笔'}}</button>
    <button class="secondary-button" bindtap="goSettlement" wx:if="{{trip.status === '进行中'}}">结账</button>
    <button class="secondary-button end-trip-button" bindtap="endTrip" wx:if="{{isOwner && trip.status === '进行中'}}">结束行程</button>
  </view>
</view>
<view wx:else class="simple-page trip-loading-page">
  <view class="simple-nav"><button class="back-button" aria-label="返回" bindtap="goBack"><view class="back-arrow"></view></button></view>
  <view class="trip-loading-copy">
    <text class="simple-title">{{loading ? '正在打开行程' : '行程暂不可见'}}</text>
    <text class="simple-lead">{{loading ? '正在同步行程和成员信息，请稍候。' : loadError}}</text>
  </view>
</view>
